# Database connection string
# We use PostgreSQL in this project.
# DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://amin@localhost:5432/url_shortener

# Public base URL used to build short links
BASE_URL=http://localhost:8000

# Optional: require this value in the X-API-Key header on POST /shorten.
# Leave unset to disable auth (default).
# API_KEY=

# Rate limit applied to POST /shorten (slowapi syntax, e.g. "10/minute")
RATE_LIMIT=10/minute

# Reject long_url values longer than this many characters
MAX_LONG_URL_LENGTH=2048
